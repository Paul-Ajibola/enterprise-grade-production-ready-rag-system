# Required by the API
GROQ_API_KEY=
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=

# Cohere is the preferred embedding provider; local sentence-transformers is the fallback.
COHERE_API_KEY=

# Optional observability and evaluation
LOGFIRE_TOKEN=
JUDGE_GROQ=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-grade-rag

# UI and durable conversation memory
BACKEND_URL=http://localhost:8000
CHECKPOINT_DB_PATH=~/.enterprise-rag/checkpoints.sqlite

# Optional Portkey routing; defaults to virtual keys named rag and brag.
PORTKEY_API_KEY=
PORTKEY_PRIMARY_SLUG=rag
PORTKEY_FALLBACK_SLUG=brag
